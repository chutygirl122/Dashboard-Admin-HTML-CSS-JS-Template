*⚙️ `script.js`*
```javascript
function toggleStatus() {
  const status = document.getElementById("status");
  if (status.textContent.includes("Offline")) {
    status.textContent = "🟢 Online";
  } else {
    status.textContent = "🔴 Offline";
  }
}
```
